pipeline {
    agent any

    tools{
        maven 'Maven3'
        jdk 'JDK17'
    }

    stages {
        stage('Build Maven') {
            steps {
            checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/Enes-Cokbekler/devops-002-pipline']])
            bat 'mvn clean install'
            }
        }


        stage('Docker Image') {
            steps {
            bat 'docker build -t enescokbekler/my-application .'
            }
        }

 stage('Docker Image to DockerHub') {
            steps {
                script{
                    withCredentials([string(credentialsId: 'dockerhub', variable: 'dockerhub')]) {
                        bat 'echo docker login -u enescokbekler -p ${dockerhub}'
                        bat 'docker push enescokbekler/my-application:latest'
                    }
                }
            }
        }

        stage('Deploy Kubernetes') {
                    steps {
                        script{
                            kubernetesDeploy (configs: 'deploymentservice.yaml', kubeconfigId: 'kuberetes')
                        }
                    }
                }
    }
}
